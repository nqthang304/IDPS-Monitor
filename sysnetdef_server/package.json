{
  "name": "sysnetdef_server",
  "version": "1.0.0",
  "description": "Firewall Controller Server",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run db:generate && ts-node-dev -r tsconfig-paths/register --respawn --ignore-watch drizzle,database --transpile-only src/index.ts",
    "db:generate": "drizzle-kit generate",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "canvas": "^3.2.3",
    "cli-table3": "^0.6.5",
    "colorette": "^2.0.20",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "ejs": "^5.0.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "socket.io": "^4.7.5",
    "systeminformation": "^5.31.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.19",
    "@types/date-fns": "^2.5.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.24.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
